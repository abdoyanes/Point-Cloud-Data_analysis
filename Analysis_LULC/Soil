    {
      "cell_type": "code",
      "source": [
        "# =============================================================================\n",
        "# ANNUAL AVERAGE ET — THREE SEPARATE TABLES\n",
        "# White Nile State, Sudan  |  MODIS MOD16A2GF  |  2001–2023\n",
        "#\n",
        "# Produces three independent tables:\n",
        "#   TA — Annual mean ET for the whole region (one row per year)\n",
        "#   TB — Annual mean ET by LULC class       (one row per year × class)\n",
        "#   TC — Annual mean ET by Soil class       (one row per year × soil)\n",
        "#\n",
        "# Paste this as a NEW cell in your Colab notebook.\n",
        "# Self-contained: rebuilds all required variables if session was reset.\n",
        "# =============================================================================\n",
        "\n",
        "import ee, os, json, glob, warnings\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import matplotlib.ticker as mticker\n",
        "import seaborn as sns\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "ee.Authenticate()\n",
        "ee.Initialize(project='evapotranspiration-495110')\n",
        "# ── 0. GEE initialise ────────────────────────────────────────────────────────\n",
        "try:\n",
        "    ee.Number(1).getInfo()\n",
        "except Exception:\n",
        "    ee.Initialize(project='evapototranspiration-495110')\n",
        "    print('GEE re-initialised')\n",
        "\n",
        "OUTPUT_DIR = '/content/drive/MyDrive/ET_WhiteNile_Analysis'\n",
        "os.makedirs(f'{OUTPUT_DIR}/tables', exist_ok=True)\n",
        "os.makedirs(f'{OUTPUT_DIR}/plots',  exist_ok=True)\n",
        "\n",
        "# ── 1. Constants ─────────────────────────────────────────────────────────────\n",
        "START_YEAR  = 2001\n",
        "END_YEAR    = 2023\n",
        "START_DATE  = f'{START_YEAR}-01-01'\n",
        "END_DATE    = f'{END_YEAR}-12-31'\n",
        "YEARS       = list(range(START_YEAR, END_YEAR + 1))\n",
        "SCALE_M     = 500          # analysis scale — matches MODIS native pixel\n",
        "COMPOSITES  = 46           # 8-day composites per year → annual total\n",
        "\n",
        "LULC_CLASSES = {\n",
        "    1: 'Evergreen_Needleleaf_Forest',  2: 'Evergreen_Broadleaf_Forest',\n",
        "    3: 'Deciduous_Needleleaf_Forest',  4: 'Deciduous_Broadleaf_Forest',\n",
        "    5: 'Mixed_Forest',                 6: 'Closed_Shrubland',\n",
        "    7: 'Open_Shrubland',               8: 'Woody_Savanna',\n",
        "    9: 'Savanna',                     10: 'Grassland',\n",
        "   11: 'Permanent_Wetland',           12: 'Cropland',\n",
        "   13: 'Urban',                       14: 'Cropland_Natural_Mosaic',\n",
        "   16: 'Barren_Bare_Soil',            17: 'Water',\n",
        "}\n",
        "SOIL_CLASSES = {\n",
        "    1: 'Sandy',    # sand ≥ 70 %\n",
        "    2: 'Loamy',    # intermediate\n",
        "    3: 'Clayey',   # clay ≥ 35 %\n",
        "}\n",
        "\n",
        "# ── 2. AOI — GEE asset → shapefile → GAUL fallback ──────────────────────────\n",
        "try:\n",
        "    _ = aoi_geometry.getInfo()\n",
        "    print('AOI: already in session')\n",
        "except NameError:\n",
        "    try:\n",
        "        _asset       = 'projects/ee-abdoyanes2016/assets/White_NIle_State'\n",
        "        AOI          = ee.FeatureCollection(_asset)\n",
        "        aoi_geometry = AOI.geometry()\n",
        "        aoi_geometry.bounds().getInfo()\n",
        "        print(f'AOI: GEE asset ({_asset})')\n",
        "    except Exception:\n",
        "        _shp = (glob.glob('/tmp/*/s_area.shp') +\n",
        "                glob.glob('/tmp/s_area.shp') +\n",
        "                glob.glob('/content/s_area.shp'))\n",
        "        if _shp:\n",
        "            import geopandas as gpd\n",
        "            _gdf         = gpd.read_file(_shp[0]).to_crs('EPSG:4326')\n",
        "            AOI          = ee.FeatureCollection(json.loads(_gdf.to_json()))\n",
        "            aoi_geometry = AOI.geometry()\n",
        "            print(f'AOI: shapefile ({_shp[0]})')\n",
        "        else:\n",
        "            _g = ee.FeatureCollection('FAO/GAUL/2015/level1')\n",
        "            AOI = _g.filter(ee.Filter.And(\n",
        "                      ee.Filter.eq('ADM0_NAME', 'Sudan'),\n",
        "                      ee.Filter.eq('ADM1_NAME', 'White Nile')))\n",
        "            aoi_geometry = AOI.geometry()\n",
        "            print('AOI: GAUL fallback')\n",
        "\n",
        "# ── 3. MOD16 collection (QC-filtered, scaled) ────────────────────────────────\n",
        "def _qc_scale(img):\n",
        "    qc  = img.select('ET_QC')\n",
        "    ok  = qc.bitwiseAnd(3).lte(1)\n",
        "    et  = img.select('ET').multiply(0.1).updateMask(ok).rename('ET_mm')\n",
        "    pet = img.select('PET').multiply(0.1).updateMask(ok).rename('PET_mm')\n",
        "    return img.addBands(et).addBands(pet).copyProperties(\n",
        "               img, ['system:time_start'])\n",
        "\n",
        "MOD16 = (ee.ImageCollection('MODIS/061/MOD16A2GF')\n",
        "           .filterDate(START_DATE, END_DATE)\n",
        "           .filterBounds(aoi_geometry)\n",
        "           .map(_qc_scale))\n",
        "\n",
        "modis_proj = MOD16.first().select('ET_mm').projection()\n",
        "print(f'MOD16 images: {MOD16.size().getInfo()}')\n",
        "\n",
        "# ── 4. LULC and Soil rasters at 500 m ────────────────────────────────────────\n",
        "LULC_500m = (ee.ImageCollection('MODIS/061/MCD12Q1')\n",
        "               .filterDate('2022-01-01', '2022-12-31')\n",
        "               .first().select('LC_Type1').clip(aoi_geometry)\n",
        "               .reproject(crs=modis_proj, scale=SCALE_M))\n",
        "\n",
        "# Soil: iSDAsoil → OpenLandMap → static fallback\n",
        "_soil_loaded = False\n",
        "for _attempt in range(3):\n",
        "    try:\n",
        "        if _attempt == 0:\n",
        "            _sand = (ee.Image('ISDASOIL/Africa/v1/sand_content_0_20cm')\n",
        "                       .select('mean_0_20').clip(aoi_geometry))\n",
        "            _clay = (ee.Image('ISDASOIL/Africa/v1/clay_content_0_20cm')\n",
        "                       .select('mean_0_20').clip(aoi_geometry))\n",
        "            _sand.reduceRegion(ee.Reducer.mean(),\n",
        "                               aoi_geometry.centroid(30),\n",
        "                               500, maxPixels=10).getInfo()\n",
        "            _src  = 'iSDAsoil v1'\n",
        "        elif _attempt == 1:\n",
        "            _sand = (ee.Image('OpenLandMap/SOL/SOL_SAND-WFRACTION_USDA-3A1A1A_M/v02')\n",
        "                       .expression(\"(b('b0')+b('b10'))/2\").rename('sand'))\n",
        "            _clay = (ee.Image('OpenLandMap/SOL/SOL_CLAY-WFRACTION_USDA-3A1A1A_M/v02')\n",
        "                       .expression(\"(b('b0')+b('b10'))/2\").rename('clay'))\n",
        "            _sand.reduceRegion(ee.Reducer.mean(),\n",
        "                               aoi_geometry.centroid(30),\n",
        "                               500, maxPixels=10).getInfo()\n",
        "            _src  = 'OpenLandMap SoilGrids 250m'\n",
        "        else:\n",
        "            _lon  = ee.Image.pixelLonLat().select('longitude')\n",
        "            _sand = _lon.gte(32.0).multiply(70).rename('sand')\n",
        "            _clay = _lon.gte(30.5).And(_lon.lte(32.0)).multiply(35).rename('clay')\n",
        "            _src  = 'Static zone approximation'\n",
        "\n",
        "        _vmask    = _sand.mask().And(_clay.mask())\n",
        "        SOIL_500m = (ee.Image(2)\n",
        "                       .where(_sand.gte(70), 1)\n",
        "                       .where(_clay.gte(35), 3)\n",
        "                       .rename('SoilClass')\n",
        "                       .updateMask(_vmask)\n",
        "                       .clip(aoi_geometry)\n",
        "                       .reproject(crs=modis_proj, scale=SCALE_M))\n",
        "        _soil_loaded = True\n",
        "        print(f'Soil: {_src}')\n",
        "        break\n",
        "    except Exception as _e:\n",
        "        print(f'Soil attempt {_attempt} failed: {_e}')\n",
        "\n",
        "# ── 5. Discover which LULC and Soil codes are present in the AOI ──────────────\n",
        "# We do this ONCE with a frequency histogram — one GEE call, not N calls.\n",
        "print('\\nDiscovering classes present in AOI...')\n",
        "\n",
        "lulc_freq_raw = LULC_500m.reduceRegion(\n",
        "    reducer=ee.Reducer.frequencyHistogram(),\n",
        "    geometry=aoi_geometry, scale=SCALE_M,\n",
        "    maxPixels=1e10, bestEffort=True\n",
        ").getInfo()\n",
        "\n",
        "soil_freq_raw = SOIL_500m.reduceRegion(\n",
        "    reducer=ee.Reducer.frequencyHistogram(),\n",
        "    geometry=aoi_geometry, scale=SCALE_M,\n",
        "    maxPixels=1e10, bestEffort=True\n",
        ").getInfo()\n",
        "\n",
        "# Parse frequency histograms → only keep codes with > 10 pixels (≥ 2.5 km²)\n",
        "lulc_key   = list(lulc_freq_raw.keys())[0]\n",
        "soil_key   = list(soil_freq_raw.keys())[0]\n",
        "\n",
        "LULC_CODES = sorted([\n",
        "    int(float(k)) for k, v in lulc_freq_raw[lulc_key].items()\n",
        "    if int(float(k)) > 0 and float(v) > 10\n",
        "])\n",
        "SOIL_CODES = sorted([\n",
        "    int(float(k)) for k, v in soil_freq_raw[soil_key].items()\n",
        "    if int(float(k)) > 0 and float(v) > 10\n",
        "])\n",
        "\n",
        "print(f'  LULC classes present : {LULC_CODES}')\n",
        "print(f'    → {[LULC_CLASSES.get(c, f\"Class_{c}\") for c in LULC_CODES]}')\n",
        "print(f'  Soil classes present : {SOIL_CODES}')\n",
        "print(f'    → {[SOIL_CLASSES.get(c, f\"Soil_{c}\") for c in SOIL_CODES]}')\n",
        "\n",
        "# =============================================================================\n",
        "# TABLE A — Annual mean ET for the WHOLE REGION (area-weighted regional mean)\n",
        "# =============================================================================\n",
        "# One row per year.  All pixels inside the AOI, no stratification.\n",
        "# ET_8day_mean   : mean of the 8-day composite values across the year (mm/8-day)\n",
        "# ET_annual_mm   : estimated annual total = ET_8day_mean × 46 composites\n",
        "# Pixel_Count    : number of valid (non-masked) ET pixels used\n",
        "# =============================================================================\n",
        "print('\\n' + '='*65)\n",
        "print('TABLE A — Regional annual mean ET (whole AOI, all pixels)')\n",
        "print('='*65)\n",
        "\n",
        "rows_A = []\n",
        "for year in YEARS:\n",
        "    yr_col = (MOD16.filter(ee.Filter.calendarRange(year, year, 'year'))\n",
        "                   .select('ET_mm')\n",
        "                   .mean()\n",
        "                   .clip(aoi_geometry))\n",
        "\n",
        "    try:\n",
        "        mean_v = yr_col.reduceRegion(\n",
        "            reducer=ee.Reducer.mean(),\n",
        "            geometry=aoi_geometry,\n",
        "            scale=SCALE_M, maxPixels=1e10, bestEffort=True\n",
        "        ).getInfo()\n",
        "        cnt_v  = yr_col.reduceRegion(\n",
        "            reducer=ee.Reducer.count(),\n",
        "            geometry=aoi_geometry,\n",
        "            scale=SCALE_M, maxPixels=1e10, bestEffort=True\n",
        "        ).getInfo()\n",
        "        et_val  = mean_v.get('ET_mm', None)\n",
        "        px_cnt  = cnt_v.get('ET_mm', 0) or 0\n",
        "        if et_val is not None:\n",
        "            rows_A.append({\n",
        "                'Year':          year,\n",
        "                'ET_8day_mm':    round(float(et_val), 3),\n",
        "                'ET_annual_mm':  round(float(et_val) * COMPOSITES, 1),\n",
        "                'Pixel_Count':   int(px_cnt),\n",
        "                'Area_km2':      round(int(px_cnt) * 0.25, 1),\n",
        "            })\n",
        "            print(f'  {year}:  {et_val*COMPOSITES:6.1f} mm/yr  '\n",
        "                  f'({int(px_cnt):,} pixels)')\n",
        "    except Exception as e:\n",
        "        print(f'  {year}: ERROR — {e}')\n",
        "\n",
        "df_A = pd.DataFrame(rows_A)\n",
        "# Add a multi-year summary row\n",
        "df_A_summary = df_A.copy()\n",
        "summary_row = {\n",
        "    'Year':         'MEAN (2001–2023)',\n",
        "    'ET_8day_mm':   round(df_A['ET_8day_mm'].mean(), 3),\n",
        "    'ET_annual_mm': round(df_A['ET_annual_mm'].mean(), 1),\n",
        "    'Pixel_Count':  round(df_A['Pixel_Count'].mean()),\n",
        "    'Area_km2':     round(df_A['Area_km2'].mean(), 1),\n",
        "}\n",
        "df_A_display = pd.concat([df_A, pd.DataFrame([summary_row])],\n",
        "                          ignore_index=True)\n",
        "\n",
        "ta_path = f'{OUTPUT_DIR}/tables/TA_Annual_ET_Regional_Mean.csv'\n",
        "df_A.to_csv(ta_path, index=False)\n",
        "print(f'\\nSaved → TA_Annual_ET_Regional_Mean.csv')\n",
        "print(f'\\nMULTI-YEAR MEAN: {df_A[\"ET_annual_mm\"].mean():.1f} mm/yr  '\n",
        "      f'| Range: {df_A[\"ET_annual_mm\"].min():.1f} – '\n",
        "      f'{df_A[\"ET_annual_mm\"].max():.1f} mm/yr')\n",
        "\n",
        "# =============================================================================\n",
        "# TABLE B — Annual mean ET by LULC class\n",
        "# =============================================================================\n",
        "# One row per year × LULC class.\n",
        "# Each LULC class is isolated using a pixel mask — same approach as the\n",
        "# main pipeline (avoids GEE grouped-reducer band-count errors).\n",
        "# =============================================================================\n",
        "print('\\n' + '='*65)\n",
        "print('TABLE B — Annual mean ET by LULC class')\n",
        "print('='*65)\n",
        "\n",
        "rows_B = []\n",
        "for year in YEARS:\n",
        "    yr_col = (MOD16.filter(ee.Filter.calendarRange(year, year, 'year'))\n",
        "                   .select('ET_mm').mean().clip(aoi_geometry))\n",
        "\n",
        "    for lulc_code in LULC_CODES:\n",
        "        lulc_name = LULC_CLASSES.get(lulc_code, f'Class_{lulc_code}')\n",
        "        mask      = LULC_500m.eq(int(lulc_code))\n",
        "        masked    = yr_col.updateMask(mask)\n",
        "\n",
        "        try:\n",
        "            mean_v = masked.reduceRegion(\n",
        "                reducer=ee.Reducer.mean(),\n",
        "                geometry=aoi_geometry,\n",
        "                scale=SCALE_M, maxPixels=1e10, bestEffort=True\n",
        "            ).getInfo()\n",
        "            cnt_v  = masked.reduceRegion(\n",
        "                reducer=ee.Reducer.count(),\n",
        "                geometry=aoi_geometry,\n",
        "                scale=SCALE_M, maxPixels=1e10, bestEffort=True\n",
        "            ).getInfo()\n",
        "            et_val = mean_v.get('ET_mm', None)\n",
        "            px_cnt = cnt_v.get('ET_mm', 0) or 0\n",
        "            if et_val is not None:\n",
        "                rows_B.append({\n",
        "                    'Year':          year,\n",
        "                    'LULC_Code':     lulc_code,\n",
        "                    'LULC_Name':     lulc_name,\n",
        "                    'ET_8day_mm':    round(float(et_val), 3),\n",
        "                    'ET_annual_mm':  round(float(et_val) * COMPOSITES, 1),\n",
        "                    'Pixel_Count':   int(px_cnt),\n",
        "                    'Area_km2':      round(int(px_cnt) * 0.25, 1),\n",
        "                })\n",
        "        except Exception as e:\n",
        "            print(f'  {year}/{lulc_name}: ERROR — {e}')\n",
        "\n",
        "    print(f'  {year}: {len(LULC_CODES)} LULC classes done')\n",
        "\n",
        "df_B = pd.DataFrame(rows_B)\n",
        "\n",
        "# ── Add per-class multi-year mean rows ──────────────────────────────────────\n",
        "mean_rows_B = []\n",
        "for lulc_code in LULC_CODES:\n",
        "    grp = df_B[df_B['LULC_Code'] == lulc_code]\n",
        "    if grp.empty: continue\n",
        "    mean_rows_B.append({\n",
        "        'Year':          'MEAN 2001–2023',\n",
        "        'LULC_Code':     lulc_code,\n",
        "        'LULC_Name':     LULC_CLASSES.get(lulc_code, f'Class_{lulc_code}'),\n",
        "        'ET_8day_mm':    round(grp['ET_8day_mm'].mean(), 3),\n",
        "        'ET_annual_mm':  round(grp['ET_annual_mm'].mean(), 1),\n",
        "        'Pixel_Count':   round(grp['Pixel_Count'].mean()),\n",
        "        'Area_km2':      round(grp['Area_km2'].mean(), 1),\n",
        "    })\n",
        "\n",
        "df_B_display = pd.concat([df_B, pd.DataFrame(mean_rows_B)],\n",
        "                           ignore_index=True)\n",
        "\n",
        "tb_path = f'{OUTPUT_DIR}/tables/TB_Annual_ET_by_LULC.csv'\n",
        "df_B.to_csv(tb_path, index=False)\n",
        "print(f'\\nSaved → TB_Annual_ET_by_LULC.csv  '\n",
        "      f'({len(df_B)} rows: {len(YEARS)} years × {len(LULC_CODES)} classes)')\n",
        "\n",
        "# Quick summary\n",
        "print('\\n  Multi-year mean ET per LULC class:')\n",
        "for _, row in pd.DataFrame(mean_rows_B).sort_values(\n",
        "        'ET_annual_mm', ascending=False).iterrows():\n",
        "    print(f'    {row[\"LULC_Name\"]:35s}  {row[\"ET_annual_mm\"]:7.1f} mm/yr  '\n",
        "          f'({row[\"Area_km2\"]:,.0f} km²)')\n",
        "\n",
        "# =============================================================================\n",
        "# TABLE C — Annual mean ET by Soil class\n",
        "# =============================================================================\n",
        "# One row per year × soil texture class (Sandy / Loamy / Clayey).\n",
        "# =============================================================================\n",
        "print('\\n' + '='*65)\n",
        "print('TABLE C — Annual mean ET by Soil texture class')\n",
        "print('='*65)\n",
        "\n",
        "rows_C = []\n",
        "for year in YEARS:\n",
        "    yr_col = (MOD16.filter(ee.Filter.calendarRange(year, year, 'year'))\n",
        "                   .select('ET_mm').mean().clip(aoi_geometry))\n",
        "\n",
        "    for soil_code in SOIL_CODES:\n",
        "        soil_name = SOIL_CLASSES.get(soil_code, f'Soil_{soil_code}')\n",
        "        mask      = SOIL_500m.eq(int(soil_code))\n",
        "        masked    = yr_col.updateMask(mask)\n",
        "\n",
        "        try:\n",
        "            mean_v = masked.reduceRegion(\n",
        "                reducer=ee.Reducer.mean(),\n",
        "                geometry=aoi_geometry,\n",
        "                scale=SCALE_M, maxPixels=1e10, bestEffort=True\n",
        "            ).getInfo()\n",
        "            cnt_v  = masked.reduceRegion(\n",
        "                reducer=ee.Reducer.count(),\n",
        "                geometry=aoi_geometry,\n",
        "                scale=SCALE_M, maxPixels=1e10, bestEffort=True\n",
        "            ).getInfo()\n",
        "            et_val = mean_v.get('ET_mm', None)\n",
        "            px_cnt = cnt_v.get('ET_mm', 0) or 0\n",
        "            if et_val is not None:\n",
        "                rows_C.append({\n",
        "                    'Year':          year,\n",
        "                    'Soil_Code':     soil_code,\n",
        "                    'Soil_Name':     soil_name,\n",
        "                    'ET_8day_mm':    round(float(et_val), 3),\n",
        "                    'ET_annual_mm':  round(float(et_val) * COMPOSITES, 1),\n",
        "                    'Pixel_Count':   int(px_cnt),\n",
        "                    'Area_km2':      round(int(px_cnt) * 0.25, 1),\n",
        "                })\n",
        "        except Exception as e:\n",
        "            print(f'  {year}/{soil_name}: ERROR — {e}')\n",
        "\n",
        "    print(f'  {year}: {len(SOIL_CODES)} soil classes done')\n",
        "\n",
        "df_C = pd.DataFrame(rows_C)\n",
        "\n",
        "# ── Add per-class multi-year mean rows ──────────────────────────────────────\n",
        "mean_rows_C = []\n",
        "for soil_code in SOIL_CODES:\n",
        "    grp = df_C[df_C['Soil_Code'] == soil_code]\n",
        "    if grp.empty: continue\n",
        "    mean_rows_C.append({\n",
        "        'Year':          'MEAN 2001–2023',\n",
        "        'Soil_Code':     soil_code,\n",
        "        'Soil_Name':     SOIL_CLASSES.get(soil_code, f'Soil_{soil_code}'),\n",
        "        'ET_8day_mm':    round(grp['ET_8day_mm'].mean(), 3),\n",
        "        'ET_annual_mm':  round(grp['ET_annual_mm'].mean(), 1),\n",
        "        'Pixel_Count':   round(grp['Pixel_Count'].mean()),\n",
        "        'Area_km2':      round(grp['Area_km2'].mean(), 1),\n",
        "    })\n",
        "\n",
        "df_C_display = pd.concat([df_C, pd.DataFrame(mean_rows_C)],\n",
        "                           ignore_index=True)\n",
        "\n",
