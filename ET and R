        "# =============================================================================\n",
        "# FIGURE — Annual ET, PET, and Rainfall  |  White Nile State, Sudan (2001–2023)\n",
        "# Publication-quality dual-axis time series from MOD16A2GF + CHIRPS.\n",
        "#\n",
        "# Design: rainfall (bars) and actual ET (line) share the LEFT axis; potential\n",
        "# ET (PET), which is an order of magnitude larger, is plotted on the RIGHT axis\n",
        "# so all three remain legible. Multi-year means are annotated in the legend.\n",
        "#\n",
        "# Paste as ONE Colab cell. Self-contained (safe after kernel restart).\n",
        "# =============================================================================\n",
        "\n",
        "import ee, os, glob, json, warnings\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import matplotlib.ticker as mticker\n",
        "from matplotlib.lines import Line2D\n",
        "from matplotlib.patches import Patch\n",
        "warnings.filterwarnings('ignore')\n",
        "\n",
        "# ── 0. Setup ─────────────────────────────────────────────────────────────────\n",
        "try:\n",
        "    ee.Number(1).getInfo()\n",
        "except Exception:\n",
        "    ee.Authenticate()\n",
        "    ee.Initialize(project='evapotranspiration-495110')\n",
        "\n",
        "OUTPUT_DIR = '/content/drive/MyDrive/ET_WhiteNile_Analysis'\n",
        "os.makedirs(f'{OUTPUT_DIR}/plots',  exist_ok=True)\n",
        "os.makedirs(f'{OUTPUT_DIR}/tables', exist_ok=True)\n",
        "\n",
        "START_YEAR, END_YEAR = 2001, 2023\n",
        "START_DATE, END_DATE = f'{START_YEAR}-01-01', f'{END_YEAR}-12-31'\n",
        "YEARS = list(range(START_YEAR, END_YEAR + 1))\n",
        "SCALE, P_SCALE, COMP = 500, 5000, 46\n",
        "\n",
        "# ── 1. AOI ───────────────────────────────────────────────────────────────────\n",
        "try:\n",
        "    _ = aoi_geometry.getInfo()\n",
        "except NameError:\n",
        "    try:\n",
        "        AOI = ee.FeatureCollection('projects/ee-abdoyanes2016/assets/White_NILe_State')\n",
        "        aoi_geometry = AOI.geometry(); aoi_geometry.bounds().getInfo()\n",
        "        print('AOI: GEE asset')\n",
        "    except Exception:\n",
        "        _g = ee.FeatureCollection('FAO/GAUL/2015/level1')\n",
        "        AOI = _g.filter(ee.Filter.And(ee.Filter.eq('ADM0_NAME','Sudan'),\n",
        "                                      ee.Filter.eq('ADM1_NAME','White Nile')))\n",
        "        aoi_geometry = AOI.geometry(); print('AOI: GAUL fallback')\n",
        "\n",
        "# ── 2. Reuse existing CSV if the Budyko cell was already run; else compute ──\n",
        "csv_path = f'{OUTPUT_DIR}/tables/T_Budyko_Regional_Annual.csv'\n",
        "if os.path.exists(csv_path):\n",
        "    df = pd.read_csv(csv_path)\n",
        "    if {'P_mm','ET_mm','PET_mm'}.issubset(df.columns):\n",
        "        print(f'Loaded existing series from {csv_path}')\n",
        "    else:\n",
        "        df = None\n",
        "else:\n",
        "    df = None\n",
        "\n",
        "if df is None:\n",
        "    print('Computing annual ET, PET, rainfall from GEE (~1 min)...')\n",
        "    def _qc(img):\n",
        "        ok = img.select('ET_QC').bitwiseAnd(3).lte(1)\n",
        "        et  = img.select('ET').multiply(0.1).updateMask(ok).rename('ET_mm')\n",
        "        pet = img.select('PET').multiply(0.1).updateMask(ok).rename('PET_mm')\n",
        "        return img.addBands(et).addBands(pet).copyProperties(img,['system:time_start'])\n",
        "    MOD16 = (ee.ImageCollection('MODIS/061/MOD16A2GF')\n",
        "               .filterDate(START_DATE,END_DATE).filterBounds(aoi_geometry).map(_qc))\n",
        "    CHIRPS = (ee.ImageCollection('UCSB-CHG/CHIRPS/DAILY')\n",
        "                .filterDate(START_DATE,END_DATE).filterBounds(aoi_geometry))\n",
        "    rows=[]\n",
        "    for y in YEARS:\n",
        "        et = (MOD16.filter(ee.Filter.calendarRange(y,y,'year')).select('ET_mm')\n",
        "                .mean().multiply(COMP).reduceRegion(ee.Reducer.mean(),aoi_geometry,\n",
        "                SCALE,maxPixels=1e10,bestEffort=True).getInfo().get('ET_mm'))\n",
        "        pet= (MOD16.filter(ee.Filter.calendarRange(y,y,'year')).select('PET_mm')\n",
        "                .mean().multiply(COMP).reduceRegion(ee.Reducer.mean(),aoi_geometry,\n",
        "                SCALE,maxPixels=1e10,bestEffort=True).getInfo().get('PET_mm'))\n",
        "        p  = (CHIRPS.filter(ee.Filter.calendarRange(y,y,'year')).sum()\n",
        "                .reduceRegion(ee.Reducer.mean(),aoi_geometry,P_SCALE,\n",
        "                maxPixels=1e10,bestEffort=True).getInfo().get('precipitation'))\n",
        "        if et and pet and p:\n",
        "            rows.append({'Year':y,'P_mm':round(p,1),'ET_mm':round(et,1),\n",
        "                         'PET_mm':round(pet,1)})\n",
        "            print(f'  {y}:  P={p:6.1f}  ET={et:6.1f}  PET={pet:7.1f}')\n",
        "    df = pd.DataFrame(rows)\n",
        "    df.to_csv(f'{OUTPUT_DIR}/tables/T_Annual_ET_PET_Rainfall.csv', index=False)\n",
        "\n",
        "yr  = df['Year'].values\n",
        "P   = df['P_mm'].values\n",
        "ET  = df['ET_mm'].values\n",
        "PET = df['PET_mm'].values\n",
        "\n",
        "# ── 3. Publication-quality figure ────────────────────────────────────────────\n",
        "plt.rcParams.update({\n",
        "    'font.family':'serif', 'font.serif':['DejaVu Serif','Times New Roman'],\n",
        "    'font.size':12, 'axes.linewidth':0.9, 'axes.edgecolor':'#444444',\n",
        "    'mathtext.fontset':'dejavuserif',\n",
        "})\n",
        "C_RAIN='#5B9BD5'; C_ET='#1B6E5E'; C_PET='#C8742B'\n",
        "\n",
        "fig, ax1 = plt.subplots(figsize=(11, 6.4))\n",
        "ax2 = ax1.twinx()\n",
        "\n",
        "# Rainfall — bars (left axis)\n",
        "b = ax1.bar(yr, P, width=0.62, color=C_RAIN, alpha=0.55,\n",
        "            edgecolor='#3C7CC0', linewidth=0.5, zorder=2,\n",
        "            label=f'Rainfall, CHIRPS  (mean {P.mean():.0f} mm yr⁻¹)')\n",
        "\n",
        "# Actual ET — line+markers (left axis)\n",
        "l_et, = ax1.plot(yr, ET, color=C_ET, lw=2.6, marker='o', ms=6,\n",
        "                 markerfacecolor='white', markeredgecolor=C_ET,\n",
        "                 markeredgewidth=1.6, zorder=4,\n",
        "                 label=f'Actual ET, MOD16  (mean {ET.mean():.0f} mm yr⁻¹)')\n",
        "\n",
        "# Potential ET — line+markers (right axis)\n",
        "l_pet, = ax2.plot(yr, PET, color=C_PET, lw=2.2, ls='--', marker='s', ms=5,\n",
        "                  markerfacecolor=C_PET, markeredgecolor='white',\n",
        "                  markeredgewidth=0.6, zorder=3,\n",
        "                  label=f'Potential ET, MOD16  (mean {PET.mean():.0f} mm yr⁻¹)')\n",
        "\n",
        "# Axes scaling — keep left and right visually separated\n",
        "ax1.set_ylim(0, max(P.max(), ET.max())*1.45)\n",
        "ax2.set_ylim(0, PET.max()*1.18)\n",
        "\n",
        "# Labels\n",
        "ax1.set_xlabel('Year', fontsize=13)\n",
        "ax1.set_ylabel('Rainfall and actual ET  (mm yr⁻¹)', fontsize=13)\n",
        "ax2.set_ylabel('Potential ET  (mm yr⁻¹)', fontsize=13, color=C_PET)\n",
        "ax2.tick_params(axis='y', colors=C_PET)\n",
        "ax1.set_xlim(START_YEAR-0.7, END_YEAR+0.7)\n",
        "ax1.xaxis.set_major_locator(mticker.MultipleLocator(2))\n",
        "ax1.set_axisbelow(True)\n",
        "ax1.grid(axis='y', color='#DDDDDD', lw=0.7, zorder=0)\n",
        "\n",
        "# Multi-year mean reference lines (subtle)\n",
        "ax1.axhline(P.mean(),  color=C_RAIN, ls=':', lw=1.1, alpha=0.7, zorder=1)\n",
        "ax1.axhline(ET.mean(), color=C_ET,   ls=':', lw=1.1, alpha=0.7, zorder=1)\n",
        "\n",
        "# Title\n",
        "ax1.set_title('Annual Water Supply, Demand, and Actual Use — White Nile State, Sudan (2001–2023)',\n",
        "              fontsize=14, fontweight='bold', color='#1A3A5C', pad=14)\n",
        "\n",
        "# Combined legend\n",
        "handles = [b, l_et, l_pet]\n",
        "ax1.legend(handles=handles, loc='upper center', bbox_to_anchor=(0.5, -0.12),\n",
        "           ncol=3, frameon=False, fontsize=11, handlelength=2.2)\n",
        "\n",
        "# Annotate aridity context (PET/P) once, top-right\n",
        "phi = PET.mean()/P.mean()\n",
        "ax2.text(0.985, 0.96, f'Aridity index  PET/P ≈ {phi:.1f}  (strongly water-limited)',\n",
        "         transform=ax2.transAxes, ha='right', va='top', fontsize=10,\n",
        "         style='italic', color='#555555',\n",
        "         bbox=dict(boxstyle='round,pad=0.4', fc='#F3F3F0', ec='#CCCCCC', lw=0.6))\n",
        "\n",
        "fig.tight_layout()\n",
        "out = f'{OUTPUT_DIR}/plots/Fig_Annual_ET_PET_Rainfall.png'\n",
        "plt.savefig(out, dpi=300, bbox_inches='tight', facecolor='white')\n",
        "plt.savefig(out.replace('.png','.pdf'), bbox_inches='tight', facecolor='white')\n",
        "plt.show()\n",
        "print(f'\\nSaved (300 dpi PNG + vector PDF):\\n  {out}')\n",
        "\n",
        "# ── 4. Quick summary ─────────────────────────────────────────────────────────\n",
        "print('\\n'+'='*56)\n",
        "print('ANNUAL MEANS (2001–2023), White Nile State')\n",
        "print('='*56)\n",
        "print(f'  Rainfall (P)   : {P.mean():7.1f} mm yr⁻¹  (range {P.min():.0f}–{P.max():.0f})')\n",
        "print(f'  Actual ET      : {ET.mean():7.1f} mm yr⁻¹  (range {ET.min():.0f}–{ET.max():.0f})')\n",
        "print(f'  Potential ET   : {PET.mean():7.1f} mm yr⁻¹  (range {PET.min():.0f}–{PET.max():.0f})')\n",
        "print(f'  ET/P           : {ET.mean()/P.mean():.3f}   (evaporative index)')\n",
        "print(f'  PET/P          : {phi:.1f}     (aridity index, >>1 = water-limited)')\n",
        "print('='*56)"
      ]
    },
