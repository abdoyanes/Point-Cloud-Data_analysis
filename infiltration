        "S = summary.set_index(\"Unit\").loc[order]\n",
        "\n",
        "mean_tif = os.path.join(WB_DIR, f\"mean_annual_wb_{START_YEAR}_{END_YEAR}.tif\")\n",
        "with rasterio.open(mean_tif) as src:\n",
        "    bands = {src.descriptions[i]: src.read(i + 1) for i in range(src.count)}\n",
        "    b = src.bounds\n",
        "    extent = (b.left, b.right, b.bottom, b.top)\n",
        "\n",
        "# =====================================================================\n",
        "# Fig 1 - lithology and CN\n",
        "# =====================================================================\n",
        "fig, ax = plt.subplots(figsize=(HALF_W * 1.35, HALF_W * 1.6))\n",
