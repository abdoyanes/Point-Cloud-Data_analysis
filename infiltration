        "ax.set_ylim(extent[2], extent[3])\n",
        "map_axes(ax)\n",
        "scale_bar_north(ax)\n",
        "handles = [Patch(fc=color[u], ec=\"black\", lw=0.3,\n",
        "                 label=f\"{u} (CN {CN_LOOKUP.get(u, '?')}): {names.get(u, '')}\") for u in order]\n",
        "ax.legend(handles=handles, loc=\"upper left\", bbox_to_anchor=(1.02, 1.0),\n",
        "          title=\"Lithological unit\", title_fontsize=7, handlelength=1.2)\n",
        "save(fig, \"Fig1_lithology_CN\")\n",
        "\n",
        "# =====================================================================\n",
        "# Fig 2 - mean annual maps P, F, AET, R\n",
        "# =====================================================================\n",
        "panels = [(\"P\", \"Precipitation, $P$\", \"YlGnBu\"),\n",
        "          (\"F\", \"Infiltration, $F$\", \"YlGnBu\"),\n",
