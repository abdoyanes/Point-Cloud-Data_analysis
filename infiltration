        "    v = np.nan_to_num(S[f\"{comp}_mean\"].to_numpy(dtype=float), nan=0.0)\n",
        "    base = np.where(v >= 0, bottom_pos, bottom_neg)\n",
        "    ax1.bar(x, v, 0.65, bottom=base, color=COMP_COL[comp], ec=\"black\", lw=0.3, label=lab)\n",
        "    bottom_pos += np.where(v >= 0, v, 0)\n",
        "    bottom_neg += np.where(v < 0, v, 0)\n",
        "ax1.scatter(x, S[\"P_mean\"], marker=\"_\", s=180, color=\"black\", lw=1.2, zorder=5,\n",
