      "cell_type": "code",
      "source": [
        "\"\"\"\n",
        "Download CHIRPS v2.0 daily precipitation (0.05 deg), 2000-2025, clipped to the\n",
        "study boundary, and save one NetCDF per year to Google Drive:\n",
        "    chirps_YYYY.nc   (variable \"precip\", mm/day, dims time/latitude/longitude)\n",
        "\n",
        "Each global yearly file (~1.1 GB) is downloaded to local Colab disk, clipped,\n",
        "saved to Drive (a few MB), and deleted. Years already on Drive are skipped,\n",
        "so a disconnect costs only the year in progress.\n",
        "\n",
        "Run in Colab:\n",
        "    from google.colab import drive; drive.mount(\"/content/drive\")\n",
        "\"\"\"\n",
        "\n",
        "import os\n",
        "import calendar\n",
        "import requests\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import xarray as xr\n",
        "import geopandas as gpd\n",
        "\n",
        "# ------------------------------- CONFIG -------------------------------\n",
        "BOUNDARY_SHP = \"/content/drive/MyDrive/water_balance/Plygone_nile for_clip.shp\"\n",
        "OUT_DIR      = \"/content/drive/MyDrive/water_balance/chirps_daily\"\n",
        "TMP_DIR      = \"/content/chirps_tmp\"\n",
        "START_YEAR   = 2000\n",
        "END_YEAR     = 2025\n",
        "PAD_DEG      = 0.25   # margin around the boundary so bilinear resampling has neighbours\n",
        "BASE_URL     = (\"https://data.chc.ucsb.edu/products/CHIRPS-2.0/global_daily/netcdf/p05/\"\n",
        "                \"chirps-v2.0.{year}.days_p05.nc\")\n",
        "# ------------------------------------------------------------------------\n",
        "\n",
        "os.makedirs(OUT_DIR, exist_ok=True)\n",
        "os.makedirs(TMP_DIR, exist_ok=True)\n",
        "\n",
        "minx, miny, maxx, maxy = gpd.read_file(BOUNDARY_SHP).to_crs(\"EPSG:4326\").total_bounds\n",
        "minx, miny, maxx, maxy = minx - PAD_DEG, miny - PAD_DEG, maxx + PAD_DEG, maxy + PAD_DEG\n",
        "print(f\"Clip box (lon {minx:.2f}-{maxx:.2f}, lat {miny:.2f}-{maxy:.2f})\")\n",
        "\n",
        "\n",
        "def download(url, dest):\n",
        "    with requests.get(url, stream=True, timeout=120) as r:\n",
        "        r.raise_for_status()\n",
        "        total = int(r.headers.get(\"content-length\", 0))\n",
        "        done = 0\n",
        "        with open(dest + \".part\", \"wb\") as f:\n",
        "            for chunk in r.iter_content(chunk_size=8 * 1024 * 1024):\n",
        "                f.write(chunk)\n",
        "                done += len(chunk)\n",
        "        if total and done != total:\n",
        "            raise IOError(f\"Incomplete download: {done}/{total} bytes\")\n",
        "    os.replace(dest + \".part\", dest)\n",
        "\n",
        "\n",
        "def year_ok(path, year):\n",
        "    try:\n",
        "        with xr.open_dataset(path) as ds:\n",
        "            return ds.sizes[\"time\"] == (366 if calendar.isleap(year) else 365)\n",
        "    except Exception:\n",
        "        return False\n",
        "\n",
        "\n",
        "for year in range(START_YEAR, END_YEAR + 1):\n",
        "    out_path = os.path.join(OUT_DIR, f\"chirps_{year}.nc\")\n",
        "    if os.path.exists(out_path) and year_ok(out_path, year):\n",
        "        print(f\"{year}: already on Drive, skipped\")\n",
        "        continue\n",
        "\n",
        "    tmp_path = os.path.join(TMP_DIR, f\"chirps_global_{year}.nc\")\n",
        "    for attempt in range(1, 4):\n",
        "        try:\n",
        "            if not os.path.exists(tmp_path):\n",
        "                print(f\"{year}: downloading global file ...\")\n",
        "                download(BASE_URL.format(year=year), tmp_path)\n",
        "            with xr.open_dataset(tmp_path) as ds:\n",
        "                lat_desc = ds[\"latitude\"][0] > ds[\"latitude\"][-1]\n",
        "                lat_slice = slice(maxy, miny) if lat_desc else slice(miny, maxy)\n",
        "                sub = ds[\"precip\"].sel(longitude=slice(minx, maxx), latitude=lat_slice).load()\n",
        "            break\n",
        "        except Exception as exc:\n",
        "            print(f\"{year}: attempt {attempt} failed ({exc})\")\n",
        "            if os.path.exists(tmp_path):\n",
        "                os.remove(tmp_path)\n",
        "    else:\n",
        "        print(f\"{year}: FAILED after 3 attempts, re-run the script\")\n",
        "        continue\n",
        "\n",
        "    n_exp = 366 if calendar.isleap(year) else 365\n",
        "    if sub.sizes[\"time\"] != n_exp:\n",
        "        print(f\"WARNING -- {year}: {sub.sizes['time']} days, {n_exp} expected\")\n",
        "    sub.to_dataset(name=\"precip\").to_netcdf(\n",
        "        out_path, encoding={\"precip\": {\"zlib\": True, \"complevel\": 4, \"dtype\": \"float32\"}})\n",
        "    os.remove(tmp_path)\n",
        "    print(f\"{year}: saved {out_path}  shape={sub.shape}  \"\n",
        "          f\"annual mean P={float(sub.sum('time').mean()):.0f} mm\")\n",
        "\n",
        "n_files = len([f for f in os.listdir(OUT_DIR) if f.startswith(\"chirps_\") and f.endswith(\".nc\")])\n",
        "print(f\"\\n{n_files} yearly files in {OUT_DIR} (expected {END_YEAR - START_YEAR + 1})\")"
      ],
