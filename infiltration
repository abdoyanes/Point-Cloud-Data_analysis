        "MO = \"mm month$^{-1}$\"\n",
        "\n",
        "\n",
        "def save(fig, name):\n",
        "    for ext in (\"png\", \"pdf\"):\n",
        "        fig.savefig(os.path.join(FIG_DIR, f\"{name}.{ext}\"), dpi=DPI)\n",
        "    plt.close(fig)\n",
        "    print(f\"saved {name}\")\n",
        "\n",
        "\n",
        "def panel_label(ax, letter, x=-0.02, y=1.02):\n",
        "    ax.text(x, y, f\"({letter})\", transform=ax.transAxes, fontweight=\"bold\",\n",
        "            ha=\"right\", va=\"bottom\", fontsize=9)\n",
        "\n",
        "\n",
        "km_fmt = FuncFormatter(lambda v, _: f\"{v / 1000:.0f}\")\n",
        "\n",
        "\n",
        "def map_axes(ax, xlabel=True, ylabel=True):\n",
        "    ax.set_aspect(\"equal\")\n",
        "    ax.xaxis.set_major_formatter(km_fmt)\n",
        "    ax.yaxis.set_major_formatter(km_fmt)\n",
        "    ax.xaxis.set_major_locator(MaxNLocator(4))\n",
        "    ax.yaxis.set_major_locator(MaxNLocator(5))\n",
        "    for s in (\"top\", \"right\"):\n",
        "        ax.spines[s].set_visible(True)\n",
        "    ax.set_xlabel(\"Easting (km)\" if xlabel else \"\")\n",
        "    ax.set_ylabel(\"Northing (km)\" if ylabel else \"\")\n",
        "    if not xlabel:\n",
        "        ax.tick_params(labelbottom=False)\n",
        "    if not ylabel:\n",
        "        ax.tick_params(labelleft=False)\n",
        "\n",
        "\n",
        "def scale_bar_north(ax, length_km=None):\n",
        "    x0, x1 = ax.get_xlim()\n",
        "    y0, y1 = ax.get_ylim()\n",
        "    w = x1 - x0\n",
        "    if length_km is None:\n",
        "        raw = w / 4 / 1000\n",
        "        length_km = min([10, 20, 25, 50, 100], key=lambda v: abs(v - raw))\n",
        "    L = length_km * 1000\n",
        "    bx, by = x0 + 0.05 * w, y0 + 0.05 * (y1 - y0)\n",
        "    h = 0.012 * (y1 - y0)\n",
        "    ax.add_patch(Rectangle((bx, by), L / 2, h, fc=\"black\", ec=\"black\", lw=0.5))\n",
        "    ax.add_patch(Rectangle((bx + L / 2, by), L / 2, h, fc=\"white\", ec=\"black\", lw=0.5))\n",
        "    for xx, t in ((bx, \"0\"), (bx + L, f\"{length_km:g} km\")):\n",
        "        ax.text(xx, by + 2.2 * h, t, ha=\"center\", va=\"bottom\", fontsize=6)\n",
        "    ax.annotate(\"N\", xy=(x1 - 0.08 * w, y1 - 0.05 * (y1 - y0)),\n",
        "                xytext=(x1 - 0.08 * w, y1 - 0.16 * (y1 - y0)),\n",
        "                ha=\"center\", va=\"center\", fontsize=8, fontweight=\"bold\",\n",
        "                arrowprops=dict(arrowstyle=\"-|>\", lw=0.8, color=\"black\", shrinkA=5, shrinkB=0))\n",
        "\n",
        "\n",
        "# =====================================================================\n",
        "# Load data\n",
        "# =====================================================================\n",
        "geo = gpd.read_file(GEOLOGY_SHP)\n",
        "boundary = gpd.read_file(BOUNDARY_SHP).to_crs(geo.crs)\n",
        "geo = gpd.clip(geo, boundary)\n",
        "geo[GEOLOGY_FIELD] = geo[GEOLOGY_FIELD].astype(str).str.strip()\n",
        "units_geo = geo.dissolve(by=GEOLOGY_FIELD).reset_index()\n",
        "\n",
        "summary = pd.read_excel(os.path.join(WB_DIR, \"water_balance_by_unit.xlsx\"),\n",
        "                        sheet_name=\"LongTerm_mean_SD\")\n",
        "annual = pd.read_csv(os.path.join(WB_DIR, \"water_balance_by_unit_annual.csv\"))\n",
        "monthly = pd.read_csv(os.path.join(WB_DIR, \"water_balance_by_unit_monthly.csv\"))\n",
        "for df in (summary, annual, monthly):\n",
        "    df[\"Unit\"] = df[\"Unit\"].astype(str).str.strip()\n",
        "\n",
        "order = sorted(summary[\"Unit\"], key=lambda u: (CN_LOOKUP.get(u, 0), u))\n",
        "color = {u: OKABE_ITO[i % len(OKABE_ITO)] for i, u in enumerate(order)}\n",
