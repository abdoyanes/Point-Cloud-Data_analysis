        "           columnspacing=1.0)\n",
        "ax1.axhline(0, color=\"black\", lw=0.5)\n",
        "panel_label(ax1, \"a\")\n",
        "\n",
        "w = 0.36\n",
        "ax2.bar(x - w / 2, S[\"ET_MOD16_mean\"], w, yerr=S[\"ET_MOD16_std\"], capsize=2,\n",
