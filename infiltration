        "          (\"R\", \"Recharge, $R$\", \"viridis\")]\n",
        "fig, axes = plt.subplots(1, 4, figsize=(FULL_W, FULL_W * 0.42))\n",
        "for k, (ax, (band, lab, cmap)) in enumerate(zip(axes, panels)):\n",
        "    arr = bands[band]\n",
        "    vmin, vmax = np.nanpercentile(arr, [2, 98])\n",
        "    im = ax.imshow(arr, extent=extent, cmap=cmap, vmin=vmin, vmax=vmax,\n",
