        "                whiskerprops={\"lw\": 0.6}, capprops={\"lw\": 0.6}, boxprops={\"lw\": 0.6})\n",
        "for patch, u in zip(bp[\"boxes\"], order):\n",
        "    patch.set_facecolor(color[u])\n",
