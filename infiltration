      "source": [
        "\"\"\"\n",
        "Download MOD16A2GF actual ET (8-day composites, 500 m) for the study boundary\n",
        "via Google Earth Engine.\n",
        "\n",
        "Output: one GeoTIFF per composite, named YYYY_MM_DD.tif (composite start date),\n",
        "int16 raw DN. ET (mm per composite) = DN * 0.1. Fill/class codes (DN > 32700:\n",
        "water, urban, barren, etc.) are written as -9999 nodata, so they cannot be\n",
        "mistaken for real ET downstream. The last composite of each year covers\n",
        "5 days (6 in leap years); water_balance_recharge.py handles that.\n",
        "\n",
        "Re-running skips files already downloaded, so a Colab disconnect costs only\n",
        "the composite in progress.\n",
        "\n",
        "Dependencies: earthengine-api, geemap\n",
        "\"\"\"\n",
        "\n",
        "import os\n",
        "import time\n",
        "import ee\n",
        "import geemap\n",
        "\n",
        "# ------------------------------- CONFIG -------------------------------\n",
        "GEE_PROJECT = \"ee-abdoyanes2016\"\n",
        "ASSET_PATH  = \"projects/ee-abdoyanes2016/assets/boundary\"\n",
        "OUT_DIR     = \"/content/mod16_et\"\n",
        "START_YEAR  = 2000\n",
        "END_YEAR    = 2025\n",
        "BUFFER_M    = 5000\n",
        "MAX_VALID_DN = 32700\n",
        "NODATA      = -9999\n",
        "RETRIES     = 3\n",
        "# ------------------------------------------------------------------------\n",
        "\n",
        "ee.Authenticate()\n",
        "ee.Initialize(project=GEE_PROJECT)\n",
        "os.makedirs(OUT_DIR, exist_ok=True)\n",
        "\n",
        "region = ee.FeatureCollection(ASSET_PATH).geometry().buffer(BUFFER_M).bounds()\n",
        "\n",
        "\n",
        "def mask_fill(img):\n",
        "    et = img.select(\"ET\")\n",
        "    return (et.updateMask(et.gte(0).And(et.lte(MAX_VALID_DN)))\n",
        "              .unmask(NODATA, False)\n",
        "              .toInt16()\n",
        "              .copyProperties(img, [\"system:time_start\"]))\n",
        "\n",
        "\n",
        "collection = (\n",
        "    ee.ImageCollection(\"MODIS/061/MOD16A2GF\")\n",
        "    .filterDate(f\"{START_YEAR}-01-01\", f\"{END_YEAR + 1}-01-01\")   # end date is exclusive\n",
        "    .filterBounds(region)\n",
        "    .map(mask_fill)\n",
        ")\n",
        "\n",
        "ids = collection.aggregate_array(\"system:index\").getInfo()\n",
        "print(f\"{len(ids)} composites for {START_YEAR}-{END_YEAR} \"\n",
        "      f\"(expected {sum(46 for _ in range(START_YEAR, END_YEAR + 1))}).\")\n",
        "\n",
        "failed = []\n",
        "for i, img_id in enumerate(ids, start=1):\n",
        "    out_path = os.path.join(OUT_DIR, f\"{img_id}.tif\")\n",
        "    if os.path.exists(out_path) and os.path.getsize(out_path) > 0:\n",
        "        continue\n",
        "    img = ee.Image(collection.filter(ee.Filter.eq(\"system:index\", img_id)).first())\n",
        "    for attempt in range(1, RETRIES + 1):\n",
        "        try:\n",
        "            geemap.ee_export_image(img, filename=out_path, scale=500, region=region,\n",
        "                                   crs=\"EPSG:4326\", file_per_band=False, verbose=False)\n",
        "            if os.path.exists(out_path):\n",
        "                break\n",
        "        except Exception as exc:  # network / quota errors\n",
        "            print(f\"  {img_id}: attempt {attempt} failed ({exc})\")\n",
        "            time.sleep(5 * attempt)\n",
        "    else:\n",
        "        failed.append(img_id)\n",
        "    if i % 50 == 0:\n",
        "        print(f\"  {i}/{len(ids)} processed\")\n",
        "\n",
        "print(f\"\\nDone. {len(ids) - len(failed)} files in {OUT_DIR}.\")\n",
        "if failed:\n",
        "    print(f\"Failed ({len(failed)}), re-run the script to retry: {failed}\")"
      ],
