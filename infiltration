        "    units_geo.boundary.plot(ax=ax, color=\"black\", lw=0.2)\n",
        "    boundary.boundary.plot(ax=ax, color=\"black\", lw=0.5)\n",
        "    ax.set_xlim(extent[0], extent[1])\n",
        "    ax.set_ylim(extent[2], extent[3])\n",
        "    map_axes(ax, xlabel=True, ylabel=(k == 0))\n",
        "    cax = make_axes_locatable(ax).append_axes(\"bottom\", size=\"4%\", pad=0.42)\n",
        "    cb = fig.colorbar(im, cax=cax, orientation=\"horizontal\", extend=\"both\")\n",
        "    cb.set_label(f\"{lab} ({YR})\", fontsize=7)\n",
