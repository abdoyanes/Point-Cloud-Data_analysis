        "rng = np.random.default_rng(0)\n",
        "for xi, (d, u) in enumerate(zip(data, order)):\n",
        "    ax.scatter(xi + rng.uniform(-0.15, 0.15, len(d)), d, s=6, color=color[u],\n",
