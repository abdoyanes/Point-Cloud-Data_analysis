        "# =====================================================================\n",
        "# Fig 3 - partition of P and ET supply\n",
        "# =====================================================================\n",
        "fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(FULL_W, FULL_W * 0.38),\n",
