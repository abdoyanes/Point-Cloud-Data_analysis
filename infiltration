        "ax2.set_xticks(x, order)\n",
        "ax2.set_ylabel(f\"Evapotranspiration ({YR})\")\n",
        "ax2.set_ylim(0, np.nanmax(S[\"ET_MOD16_mean\"] + S[\"ET_MOD16_std\"].fillna(0)) * 1.3)\n",
        "ax2.legend(loc=\"upper left\", ncol=2, handlelength=1.2)\n",
        "panel_label(ax2, \"b\")\n",
        "fig.subplots_adjust(wspace=0.3)\n",
        "save(fig, \"Fig3_partition_by_unit\")\n",
        "\n",
        "# =====================================================================\n",
        "# Fig 4 - inter-annual distribution of recharge\n",
        "# =====================================================================\n",
        "fig, ax = plt.subplots(figsize=(HALF_W * 1.2, HALF_W * 0.9))\n",
        "data = [annual.loc[annual[\"Unit\"] == u, \"R\"].dropna().to_numpy() for u in order]\n",
        "data = [d if d.size else np.array([np.nan]) for d in data]\n",
        "bp = ax.boxplot(data, positions=x, widths=0.55, patch_artist=True, showfliers=False,\n",
